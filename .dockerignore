# Keep the build context small and never ship local secrets / cruft.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.ipynb_checkpoints
**/.ipynb_checkpoints
scratchpad
*.png
# Local Streamlit secrets must never enter the image
.streamlit/secrets.toml
# Docs not needed at runtime (prompts/ IS needed — do not ignore it)
DEPLOY.md
USER_GUIDE.md
